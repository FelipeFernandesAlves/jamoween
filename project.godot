; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Jamoween"
run/main_scene="uid://bc2q8gu8yble6"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

InteractionManager="*uid://b2heftae4gwn6"
DialogueManager="*uid://c3rodes2l3gxb"
PersistenceKeyManager="*uid://dwmym6f55la42"
SceneManager="*uid://c6aii2yjm38jo"

[dialogue_manager]

runtime/balloon_path="res://interface/dialogue_balloon/balloon.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/interactables/plugin.cfg", "res://addons/menus/plugin.cfg", "res://addons/sceneloader/plugin.cfg", "res://addons/shy_juice_box/plugin.cfg", "res://addons/shysplashscreen/plugin.cfg")

